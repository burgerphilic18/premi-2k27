---
const newsText = "Latest Updates: Paper submission opens on January 01, 2027 | Proceedings will be published in Springer LNCS | Pre-conference tutorials on December 15, 2027.";
const base = import.meta.env.BASE_URL;
---

<div class="hero-fullpage w-full bg-[#0A3246] text-white relative overflow-hidden flex flex-col justify-between">
  
  <!-- Background Slideshow (Pulls local files from /public/slideshow/) -->
  <div id="heroSlideshow" class="absolute inset-0 z-0">
    <div class="slide-bg active" style={`background-image: url('${base}slideshow/iiit-campus.jpg'), url('http://googleusercontent.com/image_collection/image_retrieval/14253635725454726701_0');`}></div>
    <div class="slide-bg" style={`background-image: url('${base}slideshow/bbsr-1.jpg'), url('http://googleusercontent.com/image_collection/image_retrieval/13346427150569178358_0');`}></div>
    <div class="slide-bg" style={`background-image: url('${base}slideshow/bbsr-2.jpg'), url('https://images.unsplash.com/photo-1541829070764-84a7d30dd3f3?auto=format&fit=crop&w=1600&q=80');`}></div>
  </div>

  <!-- CSS Deep Teal Color Overlay (rgba(10, 50, 70, 0.75)) -->
  <div class="absolute inset-0 z-10 bg-[#0A3246]/75 backdrop-brightness-95"></div>

  <!-- Vertically Centered Main Content Area -->
  <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4 text-center flex-grow flex flex-col justify-center items-center">
    
    <!-- White with subtle 80% opacity + backdrop blur -->
    <div class="bg-white/80 backdrop-blur-sm border border-white/40 rounded-full p-3 shadow-xl inline-block mx-auto mb-5">
      <img 
        src={`${base}logo/PReMI_logo_bg.png`} 
        alt="PReMI 2027 Conference Emblem" 
        class="h-24 w-24 sm:h-28 sm:w-28 object-contain drop-shadow-sm"
        loading="eager"
      />
    </div>

    <!-- Main Heading (White Serif) -->
    <h1 class="text-3xl sm:text-5xl lg:text-6xl font-serif font-bold text-white tracking-tight leading-tight max-w-5xl mx-auto drop-shadow-md">
      12th International Conference on Pattern Recognition and Machine Intelligence (PReMI 2027)
    </h1>

    <!-- Subheading -->
    <p class="mt-4 sm:mt-5 text-base sm:text-lg lg:text-xl font-sans text-white/95 font-medium max-w-5xl mx-auto leading-relaxed drop-shadow-sm">
      Organised by <strong class="text-white font-semibold">International Institute of Information Technology (IIIT) Bhubaneswar,&nbsp;Odisha,&nbsp;India</strong>
    </p>

    <!-- Prominent Date Typography -->
    <div class="mt-5 sm:mt-6 inline-flex items-center justify-center gap-2 px-5 py-2 rounded-full bg-white/10 backdrop-blur-xs border border-white/20 shadow-sm text-lg sm:text-xl md:text-2xl font-serif font-semibold text-[#E5C158] tracking-wide drop-shadow-sm">
      <svg class="w-5 h-5 sm:w-6 sm:h-6 text-[#E5C158] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <span>December 15 - 18, 2027</span>
    </div>

  </div>

  <!-- Bottom Hero Area: Carousel Indicators + Full-Width Sticky Newsbar -->
  <div class="relative z-20 w-full flex flex-col items-center">
    
    <!-- Slideshow Indicator Dots sitting independently right above the newsbar -->
    <div class="mb-3 flex justify-center gap-2.5">
      <button onclick="setSlide(0)" class="w-3 h-3 rounded-full bg-white/90 dot-indicator transition-all hover:bg-white shadow-sm" aria-label="Slide 1"></button>
      <button onclick="setSlide(1)" class="w-3 h-3 rounded-full bg-white/40 dot-indicator transition-all hover:bg-white shadow-sm" aria-label="Slide 2"></button>
      <button onclick="setSlide(2)" class="w-3 h-3 rounded-full bg-white/40 dot-indicator transition-all hover:bg-white shadow-sm" aria-label="Slide 3"></button>
    </div>

    <!-- Full-Width Edge-to-Edge Sticky Newsbar -->
    <div class="w-full bg-[#E5C158] text-[#0F2942] border-t border-[#D4AE44] py-2.5 px-3 sm:px-6 shadow-md">
      <div class="w-full flex items-center gap-3 text-xs">
        <!-- Solid Navy Badge on Yellow -->
        <div class="shrink-0 px-2.5 py-0.5 bg-[#0F2942] text-[#E5C158] font-bold uppercase tracking-wider font-mono rounded text-[11px] shadow-xs">
          UPDATES
        </div>
        <div class="ticker-wrap flex-grow overflow-hidden whitespace-nowrap">
          <div class="ticker-content font-semibold text-[#0F2942]">
            <span class="inline-block px-8">{newsText}</span>
            <span class="inline-block px-8">{newsText}</span>
            <span class="inline-block px-8">{newsText}</span>
            <span class="inline-block px-8">{newsText}</span>
          </div>
        </div>
      </div>
    </div>

  </div>

</div>
