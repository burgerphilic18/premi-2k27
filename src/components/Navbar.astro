---

<nav class="navbar-sticky bg-[#FCFBE8] border-b border-[#EFEBC8] shadow-xs relative w-full">
  <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-6 h-14 flex items-center justify-between">
    
    <!-- Clean Brand Identity: Logo + Centered 2-Line Text -->
    <div class="flex-shrink-0 flex items-center mr-1">
      <a href="/" class="flex items-center gap-1.5 group">
        <img 
          src="/logo/PReMI_logo_bg.png" 
          alt="PReMI 2027 Logo" 
          class="h-9 w-9 sm:h-10 sm:w-10 object-contain shrink-0" 
        />
        <div class="flex flex-col items-center text-center leading-none">
          <span class="font-serif font-bold text-[#0F2942] text-xs sm:text-sm tracking-tight group-hover:text-[#0C4A60]">PReMI</span>
          <span class="font-sans font-extrabold text-[#0C4A60] text-[10px] sm:text-[11px] tracking-wider mt-0.5">2027</span>
        </div>
      </a>
    </div>

    <!-- Desktop Navigation Links -->
    <div class="hidden xl:flex items-center space-x-0.5 overflow-visible justify-start flex-grow pl-2">
      {navItems.map((item) => (
        !item.dropdown ? (
          <a 
            href={item.href} 
            target={item.target || undefined}
            rel={item.target ? "noopener noreferrer" : undefined}
            class="px-1.5 py-2 text-[10.5px] 2xl:text-[11px] font-semibold uppercase tracking-wider text-slate-700 hover:text-[#0F2942] hover:bg-[#E5C158]/20 rounded transition-colors whitespace-nowrap"
          >
            {item.name}
          </a>
        ) : (
          <div class="relative group">
            <a 
              href={item.href}
              target={item.target || undefined}
              rel={item.target ? "noopener noreferrer" : undefined}
              class="flex items-center gap-0.5 px-1.5 py-2 text-[10.5px] 2xl:text-[11px] font-semibold uppercase tracking-wider text-slate-700 hover:text-[#0F2942] hover:bg-[#E5C158]/20 rounded transition-colors whitespace-nowrap focus:outline-none"
            >
              <span>{item.name}</span>
              <svg class="w-3 h-3 text-slate-400 group-hover:text-[#0F2942] transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </a>
            <div class="dropdown-menu hidden group-hover:block absolute left-0 mt-0 min-w-[185px] bg-white border border-slate-200 shadow-2xl py-1 rounded-b">
              <div class="px-3 py-1.5 border-b border-slate-100 bg-[#E5C158]/15 text-[10px] font-bold uppercase tracking-wider text-[#0F2942]">
                {item.name}
              </div>
              {item.dropdown.map((sub) => (
                <a 
                  href={sub.href} 
                  target={sub.target || undefined} 
                  rel={sub.target ? "noopener noreferrer" : undefined}
                  class="block px-3.5 py-2 text-xs text-slate-700 hover:bg-[#E5C158]/15 hover:text-[#0F2942] border-l-2 border-transparent hover:border-[#E5C158] transition-colors whitespace-nowrap"
                >
                  {sub.name}
                </a>
              ))}
            </div>
          </div>
        )
      ))}
    </div>

    <!-- Mobile / Tablet Hamburger Button (< 1280px / xl) -->
    <div class="flex xl:hidden items-center ml-auto">
      <button 
        id="hamburgerBtn" 
        onclick="toggleMobileNav()" 
        aria-label="Toggle Menu" 
        class="p-2 text-[#0F2942] hover:bg-[#E5C158]/30 rounded-md focus:outline-none transition-colors"
      >
        <svg id="hamburgerIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Menu Main Drawer -->
  <div id="mobileNavContainer" class="mobile-nav-container xl:hidden bg-[#FCFBE8]">
    <div class="mobile-nav-inner px-4 py-3 divide-y divide-[#EFEBC8] text-slate-700 bg-[#FCFBE8]">
      {navItems.map((item, idx) => (
        !item.dropdown ? (
          <div class="py-2">
            <a 
              href={item.href} 
              target={item.target || undefined}
              rel={item.target ? "noopener noreferrer" : undefined}
              onclick="toggleMobileNav(false)" 
              class="block text-xs font-semibold uppercase tracking-wider text-[#0F2942] hover:text-[#0C4A60]"
            >
              {item.name}
            </a>
          </div>
        ) : (
          <div class="py-1.5">
            <button 
              onclick={`toggleMobileAccordion('acc-${idx}', 'chevron-${idx}')`} 
              class="w-full flex items-center justify-between py-1.5 text-left text-xs font-serif font-bold uppercase tracking-wider text-[#0F2942] hover:text-[#0C4A60] focus:outline-none"
            >
              <span>{item.name}</span>
              <svg id={`chevron-${idx}`} class="chevron-icon w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div id={`acc-${idx}`} class="accordion-content">
              <div class="accordion-inner pl-3 py-1 space-y-1.5 border-l-2 border-[#E5C158] mt-1">
                {item.dropdown.map((sub) => (
                  <a 
                    href={sub.href} 
                    target={sub.target || undefined} 
                    rel={sub.target ? "noopener noreferrer" : undefined}
                    onclick="toggleMobileNav(false)" 
                    class="block text-xs text-slate-600 hover:text-[#0F2942] py-0.5"
                  >
                    {sub.name}
                  </a>
                ))}
              </div>
            </div>
          </div>
        )
      ))}
    </div>
  </div>
</nav>
