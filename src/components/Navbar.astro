      { name: "Tutorials", href: "/coming-soon?title=Tutorials+Program" },
      { name: "Industry Session", href: "/coming-soon?title=Industry+Session" },
      { name: "Doctoral Colloquium", href: "/coming-soon?title=Doctoral+Colloquium+Program" },
      { name: "Cultural Program", href: "/coming-soon?title=Cultural+Program" },
    ]
  },
  {
