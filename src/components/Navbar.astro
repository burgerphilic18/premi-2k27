      { name: "Oral Presentation", href: "/coming-soon?title=Oral+Presentation+Guidelines" },
      { name: "Poster Presentation", href: "/coming-soon?title=Poster+Presentation+Guidelines" },
      { name: "Guidelines", href: "/coming-soon?title=General+Guidelines" },
